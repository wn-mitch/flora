{
  "name": "@alpaca-software/web-flora",
  "version": "0.2.0",
  "description": "Procedural watercolour plants for web pages: grows them around your text and draws them with WebGL2 or a 2D canvas",
  "keywords": [
    "watercolour",
    "flora",
    "generative",
    "procedural",
    "webgl",
    "canvas",
    "botanical",
    "illustration"
  ],
  "license": "MIT",
  "author": "Alpaca Software",
  "homepage": "https://flora.alpacasoft.dev/#engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wn-mitch/flora.git"
  },
  "bugs": {
    "url": "https://github.com/wn-mitch/flora/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && perl -pi -e 's{\"#platform\"}{\"./platform.js\"}g' dist/engine/*.js dist/engine/*.d.ts && perl -pi -e 's{\"(\\.\\.?/[^\"]*)\\.ts\"}{\"$1.js\"}g' dist/*.d.ts dist/engine/*.d.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && node tests/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts && node tests/engine/run.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.64.1",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  },
  "imports": {
    "#platform": {
      "flora-lua": "./lua/platform.d.ts",
      "default": "./src/engine/platform.ts"
    }
  }
}
